<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#0A1931" android:padding="14dp" android:layout_marginBottom="8dp">
    <TextView android:id="@+id/tvName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#00D4FF" android:textSize="15sp" android:textStyle="bold" android:text="Device Name"/>
    <TextView android:id="@+id/tvMac" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#8A9BB5" android:textSize="11sp" android:text="AA:BB:CC:DD:EE:FF"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
        <TextView android:id="@+id/tvRssi" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RSSI: -45 dBm" android:textColor="#00FF88" android:textSize="11sp" android:background="#00FF8822" android:padding="4dp"/>
        <TextView android:id="@+id/tvType" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BLE" android:textColor="#FFCC00" android:textSize="11sp" android:background="#FFCC0022" android:padding="4dp" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
